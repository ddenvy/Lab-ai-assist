# Lab AI Assistant — environment configuration.
# Copy to `.env` and fill in real values. `.env` is gitignored and never committed.

# Google Gemini API key. Required for /api/chat, /api/ask and embedding generation.
# Without it the host still starts in degraded mode (so offline tests need no credentials) and the
# AI adapters throw a descriptive error on first use; /health reports the key as absent.
GEMINI_API_KEY=your_gemini_api_key_here

# Chat model used for grounded generation. Use a pinned model name, not a rolling alias such as
# `gemini-flash-latest`: the audit log records this string as proof of what answered, so a silent
# model swap behind an alias would falsify it. gemini-2.5-flash is retired for new keys (404).
GEMINI_MODEL=gemini-3.5-flash

# Embedding model used for indexing chunks and queries.
# Must stay constant for the lifetime of a populated database: the vector store refuses
# to serve a search when more than one (model, dimension) pair is present.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Keyed HMAC secret used to store a non-reversible fingerprint of the original question
# in the append-only AI audit log. The masked question text is stored alongside it; the
# raw question is never persisted. Generate with:
#   openssl rand -hex 32
PII_HMAC_KEY=

# Demo password for seeded accounts (used only for local development and GIF recording).
# In production, use real user management or OAuth.
DEMO_PASSWORD=demo123
