@page "/"

<PageTitle>Laboratory Assistant</PageTitle>

<div class="home-container">
    <h1>Laboratory Assistant</h1>
    <p>
        The assistant answers questions based on uploaded SOPs and instrument data, cites sources,
        and logs every query in an audit journal. When no answer is found in the sources, it responds
        with "Not found in sources."
    </p>
    <ul>
        <li><a href="chat">Chat</a> — ask questions about SOPs and instrument data.</li>
        <li><a href="documents">Documents</a> — corpus and upload new documents.</li>
        <li><a href="login">Login</a> — sign in to the system.</li>
    </ul>
</div>

