@page "/login"
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Login</PageTitle>

<div class="login-container">
    <h1>Login</h1>

    @if (FailedAttempt)
    {
        <p class="error">Invalid username or password.</p>
    }

    <form method="post" action="/login">
        <AntiforgeryToken />
        <div class="field">
            <label>Username
                <input name="username" required />
            </label>
        </div>
        <div class="field">
            <label>Password
                <input name="password" type="password" required />
            </label>
        </div>
        <button type="submit">Sign In</button>
    </form>
</div>

<style>
    .login-container {
        max-width: 400px;
        margin: 3rem auto;
        padding: 2rem;
        background-color: white;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        text-align: center;
    }

    .login-container h1 {
        font-size: 2rem;
        margin-bottom: 1.5rem;
        color: #1e3a5f;
    }

    .field {
        margin-bottom: 1.5rem;
        text-align: left;
    }

    .field label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 500;
        color: #333;
    }

    .field input {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 1rem;
        box-sizing: border-box;
    }

    .field input:focus {
        outline: none;
        border-color: #1e3a5f;
        box-shadow: 0 0 0 2px rgba(30, 58, 95, 0.1);
    }

    button[type="submit"] {
        width: 100%;
        padding: 0.75rem;
        background-color: #1e3a5f;
        color: white;
        border: none;
        border-radius: 4px;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        margin-top: 1rem;
    }

    button[type="submit"]:hover {
        background-color: #162d4a;
    }

    .error {
        color: #dc2626;
        background-color: #fef2f2;
        padding: 0.75rem;
        border-radius: 4px;
        margin-bottom: 1rem;
        text-align: center;
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public bool FailedAttempt { get; set; }
}
