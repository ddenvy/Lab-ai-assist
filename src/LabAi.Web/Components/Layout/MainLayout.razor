@inherits LayoutComponentBase

<div class="page">
    <header class="topbar">
        <a class="brand" href="/">Laboratory Assistant</a>
        <nav>
            <NavLink href="documents" ActiveClass="active">Documents</NavLink>
        </nav>
    </header>
    <main class="content">
        @Body
    </main>
</div>

<style>
    .page {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .topbar {
        background-color: #1e3a5f;
        color: white;
        padding: 1rem 2rem;
        display: flex;
        align-items: center;
        gap: 2rem;
    }

    .brand {
        font-weight: bold;
        color: white;
        text-decoration: none;
        font-size: 1.2rem;
    }

    nav a {
        color: rgba(255, 255, 255, 0.8);
        text-decoration: none;
        padding: 0.5rem 1rem;
    }

    nav a:hover, nav a.active {
        color: white;
        background-color: rgba(255, 255, 255, 0.1);
        border-radius: 4px;
    }

    .content {
        flex: 1;
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem;
        width: 100%;
    }
</style>
