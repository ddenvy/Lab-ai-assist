<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabAi.Application\LabAi.Application.csproj" />
    <ProjectReference Include="..\LabAi.Domain\LabAi.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The Google connector has no stable release; 1.80.1-alpha is pinned exactly (no floating)
      because its embedding surface already churned once (AddGoogleAIEmbeddingGeneration is now
      [Obsolete] in favour of AddGoogleAIEmbeddingGenerator). See docs/adr/ADR-0002.
      Do NOT add a direct Google.GenAI reference: the connector is compiled against 0.11.0 and
      NuGet would resolve a newer, untested major.
    -->
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.80.1" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Google" Version="1.80.1-alpha" />

    <!-- EF Core version matches Mini-CDS so both projects resolve one shared graph. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!--
      Declared explicitly because this project consumes both directly: ILogger<T> in the Gemini
      adapters and IServiceCollection in AddLabAiGemini. Left to the transitive graph they arrive
      with a 1.x floor, which is a silent downgrade waiting to happen. The version tracks EF Core:
      10.0.12 requires Microsoft.Extensions.Logging 10.0.12, so pinning these lower is NU1605.
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

</Project>
