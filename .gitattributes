# Normalize line endings in the repository; check out with LF regardless of platform.
* text=auto eol=lf

*.cs    text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.slnx  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.razor text eol=lf
*.css   text eol=lf

*.png binary
*.gif binary
*.pdf binary
*.db  binary
